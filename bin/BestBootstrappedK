#!/usr/bin/env python

import sys

list_cv_error = sys.argv[1]

k_CV = {}
for i in open(list_cv_error):
    split_i = i.strip().split(' ')
    cverror = float(split_i[-1])
    if '(K=' in i:
        K = int(split_i[2].replace('(K=', '').replace('):', ''))
    elif 'K=' in i:
        K = int(split_i[0].replace('K=', '').replace(':', ''))
    if K not in k_CV:
        k_CV[K] = [cverror]
        continue
    k_CV[K] += [cverror]

Ks = sorted([K for K in k_CV])

MeanCV = []
for K in Ks:
    MeanCV.append(sum(k_CV[K]) / float(len(k_CV[K])))
Values = sorted(zip(MeanCV, Ks))
print(Values[0][1])
